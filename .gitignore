 # ===============================
# BACKEND IGNORES
# ===============================

# Node modules
backend/node_modules/

# Environment variables (contains passwords!)
backend/.env
backend/.env.*
backend/*.env

# Logs
backend/logs/
backend/*.log
backend/npm-debug.log*

# Database files (if using local files)
backend/data/
backend/*.db
backend/*.sqlite

# OS files
backend/.DS_Store
backend/Thumbs.db

# ===============================
# FRONTEND IGNORES
# ===============================

# Node modules
frontend/node_modules/

# Build folder (generated, don't track)
frontend/build/
frontend/dist/

# Environment variables
frontend/.env
frontend/.env.*
frontend/*.env

# Logs
frontend/*.log
frontend/npm-debug.log*

# OS files
frontend/.DS_Store
frontend/Thumbs.db

# ===============================
# GENERAL IGNORES
# ===============================

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.cache

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage directory (testing)
coverage/
.nyc_output/

# Misc
*.pem
*.p12
*.key
*.cert

# Don't ignore these important files
!backend/package.json
!frontend/package.json
!backend/package-lock.json
!frontend/package-lock.json